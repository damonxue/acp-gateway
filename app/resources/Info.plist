<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Agent Gateway</string>
	<key>CFBundleDisplayName</key>
	<string>Agent Gateway</string>
	<key>CFBundleIdentifier</key>
	<string>com.agentgateway.app</string>
	<key>CFBundleExecutable</key>
	<string>agent-gateway-app</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The app is a window onto a local daemon; it has no document types and
	     should not appear as a document-based application. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- The gateway binds to loopback and only reaches out to a relay/tunnel the
	     user configured; no other entitlements are needed. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
